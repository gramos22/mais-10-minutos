{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/build_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,.pytest_cache/**,tests/**,data/**,docs/**,scripts/**,train.py,pipeline.py,requirements-lock.txt,requirements-dev.txt}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    }
  ]
}
